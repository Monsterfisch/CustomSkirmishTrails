{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Monsterfisch/CustomSkirmishTrails/resources/mission.schema.json",
  "title": "Custom Skirmish Trails: mission file (format 1)",
  "description": "One mission of a trail, the same data as one line of the trail csv file. Export / Import and trail_missions convert between both.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": 1
    },
    "map_name": {
      "type": "string"
    },
    "mission_name": {
      "type": "string"
    },
    "text_description": {
      "description": "The 8 description lines of the briefing.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 8
    },
    "advantage": {
      "description": "Who is favoured (csv: fairness 1-5).",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "human_large",
            "human_small",
            "neutral",
            "ai_small",
            "ai_large"
          ]
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      ]
    },
    "start_mode": {
      "description": "Starting conditions (csv: start_levels 1-3).",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "normal",
            "crusader",
            "deathmatch"
          ]
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      ]
    },
    "players": {
      "description": "One entry per player; their number is the mission's number of players.",
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": [
        {
          "type": "object",
          "description": "players[0]: the human player (player 1). Has no \"ai\".",
          "properties": {
            "lord": {
              "type": "string",
              "enum": [
                "Arab",
                "Europ"
              ],
              "description": "The human player's lord (and starting troops) in this mission."
            },
            "skip_start_units": {
              "type": "integer",
              "enum": [
                0,
                1
              ],
              "description": "1: no starting troops (the lord still comes)."
            },
            "name": {
              "description": "The player's name in this mission; empty keeps the usual name.",
              "type": "string"
            },
            "start_position": {
              "type": "integer",
              "minimum": 0
            },
            "team": {
              "type": "integer",
              "minimum": 0
            },
            "aiv_type": {
              "type": "integer",
              "minimum": 0
            },
            "gold": {
              "description": "Start gold",
              "type": "integer",
              "minimum": 0
            }
          },
          "not": {
            "required": [
              "ai"
            ]
          },
          "additionalProperties": false
        }
      ],
      "additionalItems": {
        "type": "object",
        "description": "players[1..7]: AI players. Has no \"lord\".",
        "properties": {
          "ai": {
            "type": "string",
            "description": "AI key (SK_RAT, ...) or its name from the trail settings file's ai_character_mapping."
          },
          "name": {
            "description": "The player's name in this mission; empty keeps the usual name.",
            "type": "string"
          },
          "start_position": {
            "type": "integer",
            "minimum": 0
          },
          "team": {
            "type": "integer",
            "minimum": 0
          },
          "aiv_type": {
            "type": "integer",
            "minimum": 0
          },
          "gold": {
            "description": "Start gold",
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "ai"
        ],
        "additionalProperties": false
      }
    },
    "producible": {
      "description": "Weapons the player may produce: 1 / 0 (csv: producible_*).",
      "type": "object",
      "additionalProperties": {
        "type": [
          "integer",
          "string"
        ]
      }
    },
    "recruitable": {
      "description": "Units the player may recruit: 1 / 0 (csv: recruitable_*).",
      "type": "object",
      "additionalProperties": {
        "type": [
          "integer",
          "string"
        ]
      }
    },
    "resources": {
      "description": "Starting goods (csv: resource_*).",
      "type": "object",
      "additionalProperties": {
        "type": [
          "integer",
          "string"
        ]
      }
    },
    "tradeable": {
      "description": "Goods the market trades: 1 / 0 (csv: tradeable_*).",
      "type": "object",
      "additionalProperties": {
        "type": [
          "integer",
          "string"
        ]
      }
    },
    "extra": {
      "description": "Csv columns that have no place above, kept so that nothing is lost.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "format",
    "map_name",
    "players"
  ],
  "additionalProperties": false
}
